cc_library {
    name: "libbase_shim",
    srcs: [
        "libbase_shim.cpp",
    ],
    vendor: true
}

cc_library {
    name: "libbluetooth_mtk_pure",
    srcs: [
        "libbluetooth_mtk_pure.c",
    ],
    vendor: true,
}

cc_library_shared {
    name: "libcamsensormeta_shim",
    srcs: ["libcamsensormeta_shim.cpp"],
    shared_libs: ["libdl"],
    ldflags: ["-Wl,-z,global"],
    compile_multilib: "32",
    vendor: true,
}
