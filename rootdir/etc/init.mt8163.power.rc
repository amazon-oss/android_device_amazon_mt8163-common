on early-init
    # ZRAM compression
    write /sys/block/zram0/comp_algorithm zstd

on init
    # Camera daemon cpuset
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0
    write /dev/cpuset/camera-daemon/mems 0
    chown system system /dev/cpuset/camera-daemon
    chown system system /dev/cpuset/camera-daemon/tasks
    chmod 0664 /dev/cpuset/camera-daemon/tasks

    # Tune cpusets parameters
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/foreground/boost/cpus 0-3
    write /dev/cpuset/background/cpus 0
    write /dev/cpuset/system-background/cpus 0-1
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/camera-daemon/cpus 2-3

on boot
    write /proc/sys/vm/dirty_writeback_centisecs 300

on post-fs
    # Tune ZRAM
    write /sys/block/zram0/max_comp_streams 4
    write /sys/block/mmcblk0/queue/read_ahead_kb 128

    # Deadline scheduler
    write /sys/block/mmcblk0/queue/scheduler deadline

on property:sys.boot_completed=1
    # KSM
    write /sys/kernel/mm/ksm/pages_to_scan 100
    write /sys/kernel/mm/ksm/sleep_millisecs 250
    write /sys/kernel/mm/ksm/run 1

    # VM tuning
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 200
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/dirty_ratio 10
    write /proc/sys/vm/min_free_kbytes 16384

    # Enable ZRAM
    swapon_all /fstab.mt8163

    # LMK
    write /sys/module/lowmemorykiller/parameters/adj "0,100,200,300,900,950"
    write /sys/module/lowmemorykiller/parameters/minfree "4608,5888,6912,8192,14080,20480"

    # CPU
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "performance"
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor "performance"