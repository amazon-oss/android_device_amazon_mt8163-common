on boot
    write /proc/sys/vm/dirty_writeback_centisecs 300

on post-fs-data
    # Set permissions for PowerHAL
    chown system system /proc/hps/rush_boost_enabled
    chmod 660 /proc/hps/rush_boost_enabled

    chown system system /sys/kernel/debug/ged/hal/fps_upper_bound
    chmod 660 /sys/kernel/debug/ged/hal/fps_upper_bound

    chown system system /sys/devices/platform/dynamic_boost/dynamic_boost
    chmod 660 /sys/devices/platform/dynamic_boost/dynamic_boost

    # Adjust minimum free memory space (default is 2.5M)
    write /proc/sys/vm/min_free_kbytes 16384

    # Adjust zRAM algorithm to lz4
    write /sys/block/zram0/comp_algorithm lz4

    # Set swappiness from 60 to 180
    write /dev/memcg/memory.swappiness 180
    write /dev/memcg/apps/memory.swappiness 180
    write /dev/memcg/system/memory.swappiness 180
    write /proc/sys/vm/swappiness 180

    # Disable read-ahead for swap devices
    write /proc/sys/vm/page-cluster 0

    swapon_all /vendor/etc/fstab.mt8163

on property:sys.boot_completed=1
    write /sys/kernel/rcu_expedited 1
    write /sys/power/pm_print_times 0

    # interactive: set target_loads to 70%
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads 70
